#!/usr/bin/env rvs
# test.rvs —— PiliPlus macOS 开发：编译 + 停旧 + 启动
#
# 用法：
#   rvs test.rvs               编译 + 从 build 目录启动
#
# 快捷操作：
#   停止：   pkill -f PiliPlus
#   日志文件： ~/Documents/piliplus_shortvideo_log.jsonl

write-output "=== PiliPlus (macOS release) — 构建+启动 ==="
write-output ""

# ═══════════════════════════════════════════════
# Phase 1：停掉旧实例
# ═══════════════════════════════════════════════
write-output "== Phase 1: 停掉旧 PiliPlus =="
pkill -9 -f "PiliPlus.app"
sleep 2
write-output ""

# ═══════════════════════════════════════════════
# Phase 2：编译
# ═══════════════════════════════════════════════
write-output "== Phase 2: flutter clean + build macos --release =="
write-output ""
# 必须 clean，否则 incremental build 会丢失 media_kit_video 原生插件链接
# rvs 不实现 POSIX 内建 export；代理环境用 env "KEY=val" 注入（引号保护 =）
# rvs 遇失败命令自动中止脚本，无需 $LASTEXITCODE 检查
env "https_proxy=http://127.0.0.1:7890" "http_proxy=http://127.0.0.1:7890" fvm flutter clean
env "https_proxy=http://127.0.0.1:7890" "http_proxy=http://127.0.0.1:7890" fvm flutter pub get
env "https_proxy=http://127.0.0.1:7890" "http_proxy=http://127.0.0.1:7890" fvm flutter build macos --release
write-output ""

# ═══════════════════════════════════════════════
# Phase 3：启动
# ═══════════════════════════════════════════════
write-output "== Phase 3: 启动 PiliPlus =="
open build/macos/Build/Products/Release/PiliPlus.app
write-output ""
write-output "===> 已启动。短视频日志: ~/Documents/piliplus_shortvideo_log.jsonl"
